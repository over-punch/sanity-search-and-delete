{
  "name": "@overpunch/sanity-search-and-delete",
  "version": "2.1.1",
  "description": "Flexible search and delete utility for Sanity Studio — bulk content management with danger mode safety features",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "esbuild src/index.jsx --bundle=true --format=esm --jsx=automatic --external:react --external:react-dom --external:sanity --external:@sanity/* --external:@overpunch/* --outfile=dist/index.js",
    "capture": "node scripts/capture.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "sanity",
    "sanity-studio",
    "search",
    "delete",
    "bulk-operations",
    "content-management",
    "utility",
    "admin-tool"
  ],
  "author": "Quinn Keaveney <hello@liiift.studio>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/over-punch/sanity-search-and-delete.git"
  },
  "bugs": {
    "url": "https://github.com/over-punch/sanity-search-and-delete/issues"
  },
  "homepage": "https://github.com/over-punch/sanity-search-and-delete#readme",
  "peerDependencies": {
    "@sanity/icons": ">=2 <6",
    "@sanity/ui": ">=2 <5",
    "react": "^18.0.0 || ^19.0.0",
    "sanity": ">=3 <7"
  },
  "devDependencies": {
    "@sanity/icons": "^5.2.1",
    "@sanity/ui": "^4.0.5",
    "esbuild": "^0.25.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@overpunch/sanity-ui-compat": "^0.1.2"
  }
}
